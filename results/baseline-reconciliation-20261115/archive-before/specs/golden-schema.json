{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jclprof.local/schemas/golden-case-file/1",
  "title": "JCL Profiler Golden Test case file (schema version 1)",
  "description": "See docs/golden-view.md. verification_status is a run result and is NOT allowed in a definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "category",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "category": {
      "$ref": "#/$defs/category"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "category": {
      "enum": [
        "JOB_EXEC_DD",
        "CONTINUATION_COLUMNS",
        "QUOTES_PARENTHESES",
        "DD_CONCATENATION",
        "GDG_DISP",
        "INSTREAM_DATA",
        "PROC_PEND",
        "JCLLIB_INCLUDE_SET",
        "IF_THEN_ELSE",
        "COND",
        "INVALID_UNRESOLVED"
      ]
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "span": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/line"
        },
        {
          "$ref": "#/$defs/line"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "category",
        "description",
        "rule_ids",
        "source_reference",
        "input_file",
        "input_kind",
        "case_type",
        "validation_stage",
        "expected_structure",
        "expected_diagnostics",
        "oracle_method",
        "oracle_author",
        "review_status",
        "notes"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^G-[A-Z]{2,5}-[0-9]{3}$"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "description": {
          "$ref": "#/$defs/nonempty"
        },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$"
          }
        },
        "source_reference": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "url",
              "edition",
              "section",
              "pages"
            ],
            "properties": {
              "rule_id": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "edition": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "pages": {
                "type": "string"
              }
            }
          }
        },
        "input_file": {
          "type": "string",
          "pattern": "^(inputs/[A-Za-z0-9_./-]+|corpus://[A-Za-z0-9_-]+/[A-Za-z0-9_./-]+)$"
        },
        "input_kind": {
          "enum": [
            "job",
            "proc_member",
            "include_member"
          ]
        },
        "case_type": {
          "enum": [
            "valid",
            "invalid",
            "boundary",
            "unresolved"
          ]
        },
        "validation_stage": {
          "enum": [
            "lexical",
            "syntactic",
            "resolution",
            "semantic"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lines"
          ],
          "properties": {
            "lines": {
              "$ref": "#/$defs/span"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jes": {
              "enum": [
                "JES2",
                "JES3",
                "UNKNOWN"
              ]
            },
            "datasets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dsn",
                  "path"
                ],
                "properties": {
                  "dsn": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^libs/"
                  }
                }
              }
            },
            "member_name": {
              "type": "string"
            }
          }
        },
        "corpus_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root_id",
            "rel_path",
            "sha256",
            "lines"
          ],
          "properties": {
            "root_id": {
              "type": "string"
            },
            "rel_path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "lines": {
              "$ref": "#/$defs/span"
            }
          }
        },
        "expected_structure": {
          "$ref": "#/$defs/expected_structure"
        },
        "expected_diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "items"
          ],
          "properties": {
            "mode": {
              "enum": [
                "exact"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diag"
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "oracle_method": {
          "$ref": "#/$defs/nonempty"
        },
        "oracle_author": {
          "$ref": "#/$defs/nonempty"
        },
        "review_status": {
          "enum": [
            "draft",
            "reviewed",
            "approved",
            "blocked"
          ]
        },
        "blocked_reason": {
          "$ref": "#/$defs/nonempty"
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_by",
            "approved_on"
          ],
          "properties": {
            "approved_by": {
              "$ref": "#/$defs/nonempty"
            },
            "approved_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "change_log": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "reason",
              "before",
              "after",
              "basis",
              "approver"
            ],
            "properties": {
              "date": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "before": {},
              "after": {},
              "basis": {
                "type": "string"
              },
              "approver": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "blocked"
              }
            },
            "required": [
              "review_status"
            ]
          },
          "then": {
            "required": [
              "blocked_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "approved"
              }
            },
            "required": [
              "review_status"
            ]
          },
          "then": {
            "required": [
              "approval"
            ]
          }
        }
      ]
    },
    "diag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "line"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(INV|LEX|PAR|RES|SEM)-[EWI][0-9]{3}$"
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "line": {
          "oneOf": [
            {
              "$ref": "#/$defs/line"
            },
            {
              "type": "null"
            }
          ]
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "type": "string"
        }
      }
    },
    "expected_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view"
      ],
      "properties": {
        "view": {
          "enum": [
            "statements",
            "exec_conditions",
            "dd_resources",
            "substitutions",
            "effective_statements",
            "none",
            "lexical"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonempty"
        },
        "statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stmt"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "exec_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exec_cond"
          }
        },
        "dd_resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dd_resource"
          }
        },
        "substitutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/substitution"
          }
        },
        "effective_statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effective_stmt"
          }
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lex_record"
          }
        },
        "lexical_statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lex_stmt"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "view": {
                "const": "none"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "statements"
              }
            }
          },
          "then": {
            "required": [
              "statements"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "exec_conditions"
              }
            }
          },
          "then": {
            "required": [
              "exec_conditions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "dd_resources"
              }
            }
          },
          "then": {
            "required": [
              "dd_resources"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "substitutions"
              }
            }
          },
          "then": {
            "required": [
              "substitutions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "effective_statements"
              }
            }
          },
          "then": {
            "required": [
              "effective_statements"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "lexical"
              }
            }
          },
          "then": {
            "required": [
              "records",
              "lexical_statements"
            ]
          }
        }
      ]
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "q"
          ],
          "properties": {
            "q": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kw"
          ],
          "properties": {
            "kw": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/value"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "stmt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "span"
      ],
      "properties": {
        "kind": {
          "enum": [
            "JOB",
            "EXEC",
            "DD",
            "PROC",
            "PEND",
            "JCLLIB",
            "INCLUDE",
            "SET",
            "IF",
            "ELSE",
            "ENDIF",
            "OUTPUT",
            "COMMENT",
            "NULL",
            "DELIMITER",
            "JES2",
            "UNKNOWN"
          ]
        },
        "span": {
          "oneOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "type": "string"
        },
        "positional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/value"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "comment": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "condition": {
          "$ref": "#/$defs/cond"
        },
        "implicit": {
          "type": "boolean"
        },
        "inline_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "records",
            "terminator"
          ],
          "properties": {
            "records": {
              "oneOf": [
                {
                  "$ref": "#/$defs/span"
                },
                {
                  "type": "null"
                }
              ]
            },
            "terminator": {
              "enum": [
                "DELIMITER",
                "NEXT_STATEMENT",
                "EOF"
              ]
            },
            "delimiter": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "comment_raw": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "column",
              "text"
            ],
            "properties": {
              "line": {
                "$ref": "#/$defs/line"
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "implicit_basis": {
          "type": "string"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "end"
      ],
      "properties": {
        "kind": {
          "enum": [
            "PROC",
            "IF"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "$ref": "#/$defs/line"
        },
        "else": {
          "oneOf": [
            {
              "$ref": "#/$defs/line"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "oneOf": [
            {
              "$ref": "#/$defs/line"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cond": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "enum": [
                "GT",
                "LT",
                "NG",
                "NL",
                "EQ",
                "NE",
                "GE",
                "LE"
              ]
            },
            "left": {
              "$ref": "#/$defs/cond"
            },
            "right": {
              "$ref": "#/$defs/cond"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "AND",
                "OR"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/cond"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "NOT"
            },
            "arg": {
              "$ref": "#/$defs/cond"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kw"
          ],
          "properties": {
            "kw": {
              "type": "string"
            },
            "step": {
              "type": [
                "string",
                "null"
              ]
            },
            "procstep": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "num"
          ],
          "properties": {
            "num": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "exec_cond": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "line",
        "conds"
      ],
      "properties": {
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "conds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "qualifier",
              "tests",
              "even",
              "only"
            ],
            "properties": {
              "qualifier": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "even": {
                "type": "boolean"
              },
              "only": {
                "type": "boolean"
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "op",
                    "step",
                    "procstep"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "op": {
                      "enum": [
                        "GT",
                        "GE",
                        "EQ",
                        "LT",
                        "LE",
                        "NE"
                      ]
                    },
                    "step": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "procstep": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dd_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "ddname",
        "concat_index",
        "line",
        "dsn",
        "generation",
        "disp"
      ],
      "properties": {
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "ddname": {
          "type": "string"
        },
        "concat_index": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "dsn": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "type": [
            "integer",
            "null"
          ]
        },
        "disp": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "normal",
                "abnormal",
                "defaulted"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "NEW",
                    "OLD",
                    "SHR",
                    "MOD"
                  ]
                },
                "normal": {
                  "oneOf": [
                    {
                      "enum": [
                        "DELETE",
                        "KEEP",
                        "PASS",
                        "CATLG",
                        "UNCATLG"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "runtime_dependent"
                      ],
                      "properties": {
                        "runtime_dependent": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "if_new",
                            "if_existing",
                            "basis"
                          ],
                          "properties": {
                            "if_new": {
                              "enum": [
                                "DELETE",
                                "KEEP",
                                "PASS",
                                "CATLG",
                                "UNCATLG"
                              ]
                            },
                            "if_existing": {
                              "enum": [
                                "DELETE",
                                "KEEP",
                                "PASS",
                                "CATLG",
                                "UNCATLG"
                              ]
                            },
                            "basis": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "abnormal": {
                  "oneOf": [
                    {
                      "enum": [
                        "DELETE",
                        "KEEP",
                        "CATLG",
                        "UNCATLG"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "runtime_dependent"
                      ],
                      "properties": {
                        "runtime_dependent": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "if_new",
                            "if_existing",
                            "basis"
                          ],
                          "properties": {
                            "if_new": {
                              "enum": [
                                "DELETE",
                                "KEEP",
                                "CATLG",
                                "UNCATLG"
                              ]
                            },
                            "if_existing": {
                              "enum": [
                                "DELETE",
                                "KEEP",
                                "CATLG",
                                "UNCATLG"
                              ]
                            },
                            "basis": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "defaulted": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "status",
                      "normal",
                      "abnormal"
